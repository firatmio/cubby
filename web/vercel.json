{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/invites/:code", "destination": "/api/invite?code=:code" },
    { "source": "/join/:code", "destination": "/api/join?code=:code" },
    { "source": "/join", "destination": "/api/join" },
    { "source": "/", "destination": "/api/page" },
    { "source": "/((?!api/).*)", "destination": "/api/page?notfound=1" }
  ]
}
