{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/invites/:code/meta",
      "destination": "/api/invite-meta?code=:code"
    },
    {
      "source": "/api/invites/:code/status",
      "destination": "/api/invite-status?code=:code"
    },
    {
      "source": "/api/invites/:code/shared/act",
      "destination": "/api/shared-act?code=:code"
    },
    {
      "source": "/api/invites/:code/shared/force",
      "destination": "/api/shared?code=:code&op=force"
    },
    {
      "source": "/api/invites/:code/shared",
      "destination": "/api/shared?code=:code"
    },
    {
      "source": "/api/invites/:code",
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/join/:code",
      "destination": "/api/join?code=:code"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/join",
      "destination": "/api/join"
    },
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/page?notfound=1"
    }
  ]
}
