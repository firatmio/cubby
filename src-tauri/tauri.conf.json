{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubby",
  "version": "0.2.0-beta.3",
  "identifier": "com.quacomes.cubby",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cubby",
        "width": 1200,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cubby"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1MEY5NDcwNTM0QTI1NTcKUldSWEpVcFRjSlFQOVdnK2traWZSRGorSXQ3Q1NncVpaWkUyQmllUXIzZDFyUzFNMTlMUGJJYy8K",
      "endpoints": [
        "https://cubby.quacomes.com/api/update?channel=stable&target={{target}}&arch={{arch}}&current={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
